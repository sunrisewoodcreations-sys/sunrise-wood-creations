# ============================================================
# Copy this file to ".env.local" and fill in the real values.
# Never share this file or commit it to a public place.
# The deployment guide explains exactly where to find each one.
# ============================================================

# From your Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# From your Resend account -> API Keys
RESEND_API_KEY=

# The email address customer emails will come from (must be verified in Resend)
EMAIL_FROM="Sunrise Wood Creations <orders@sunrisewoodcreations.com>"

# The email address invoices specifically will come from (must be verified in Resend)
EMAIL_FROM_INVOICE="Sunrise Wood Creations <invoice@sunrisewoodcreations.com>"

# Your shop's real inbox, used for internal notifications (e.g. a proof was declined)
SHOP_NOTIFY_EMAIL=sunrisewoodcreations@gmail.com

# The live web address of your site once deployed (used inside emails for links)
NEXT_PUBLIC_SITE_URL=https://sunrisewoodcreations.com

# From platform.openai.com -> API Keys. Required for the admin-only
# cornhole design generator (src/app/admin/designs). Needs billing set up
# on your OpenAI account before image generation will work.
OPENAI_API_KEY=

# A random secret string you make up yourself (any long random text works).
# Protects the automated financial report cron job so nobody else can
# trigger it by just visiting its URL. Set the SAME value here and in
# Vercel's environment variables — Vercel Cron sends it automatically.
CRON_SECRET=
